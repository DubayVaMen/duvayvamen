{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dubayvamen",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*"]
  },
  // Telegram bot nomi (kirish tugmasi uchun). Token va admin ID lar GitHub secret orqali keladi.
  "vars": { "BOT_USERNAME": "dubayvamenbot" },
  // Turlar va rasmlar shu yerda. ID birinchi deployda avtomatik yaratiladi.
  "kv_namespaces": [{ "binding": "DB" }],
  // Buyurtmalar uchun bir zumda mos keladigan xotira (KV dan farqli ravishda kechikmaydi)
  "durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "OrdersStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrdersStore"] }],
  "observability": { "enabled": true }
}
