{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dubayvamen",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*"]
  },
  // Turlar, buyurtmalar va rasmlar shu yerda. ID birinchi deployda avtomatik yaratiladi.
  "kv_namespaces": [{ "binding": "DB" }],
  "observability": { "enabled": true }
}
